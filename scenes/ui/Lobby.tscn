[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Lobby.gd" id="1_script"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 260.0
offset_top = 80.0
offset_right = 1020.0
offset_bottom = 650.0

[node name="Content" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Panel/Content"]
layout_mode = 2
text = "ONLINE - SAME WI-FI"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 40

[node name="Instructions" type="Label" parent="Panel/Content"]
layout_mode = 2
text = "One phone hosts. On the other phone, enter the host's Wi-Fi IP."
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 28

[node name="IpField" type="LineEdit" parent="Panel/Content"]
layout_mode = 2
placeholder_text = "Host IP address, e.g. 192.168.1.10"
custom_minimum_size = Vector2(0, 60)
theme_override_font_sizes/font_size = 28

[node name="HostButton" type="Button" parent="Panel/Content"]
layout_mode = 2
text = "Host Match"
custom_minimum_size = Vector2(0, 68)
theme_override_font_sizes/font_size = 32

[node name="JoinButton" type="Button" parent="Panel/Content"]
layout_mode = 2
text = "Join Match"
custom_minimum_size = Vector2(0, 68)
theme_override_font_sizes/font_size = 32

[node name="StatusLabel" type="Label" parent="Panel/Content"]
layout_mode = 2
text = ""
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 28

[node name="BackButton" type="Button" parent="Panel/Content"]
layout_mode = 2
text = "Back"
custom_minimum_size = Vector2(0, 60)
theme_override_font_sizes/font_size = 28

[connection signal="pressed" from="Panel/Content/HostButton" to="." method="_on_host_pressed"]
[connection signal="pressed" from="Panel/Content/JoinButton" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Panel/Content/BackButton" to="." method="_on_back_pressed"]
